rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function profilePath(appId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid);
    }

    function isActiveUser(appId) {
      return isSignedIn()
        && exists(profilePath(appId))
        && get(profilePath(appId)).data.disabled != true;
    }

    function isAdminUser(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'ADMIN';
    }

    function isUsuarioRole(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'USUARIO';
    }

    function isTecnicoRole(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'TECNICO';
    }

    // ALMACEN y PROMOTORA solo leen: ninguna regla de escritura los incluye.
    function isAlmacenRole(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'ALMACEN';
    }

    function isPromotoraRole(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'PROMOTORA';
    }

    // INFRAESTRUCTURA solo lee: las instalaciones y los reportes de cierre donde quedan las ya archivadas (nada más).
    function isInfraestructuraRole(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'INFRAESTRUCTURA';
    }

    // FINANZAS lee las órdenes, los técnicos y los reportes (sin escribir nada de eso) y lleva sus propias colecciones: la conciliación de
    // cobros, las tarifas y los pagos a técnicos (más abajo). El ADMIN también las escribe.
    function isFinanzasRole(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'FINANZAS';
    }

    function llevaFinanzas(appId) {
      return isAdminUser(appId) || isFinanzasRole(appId);
    }

    // ADMINISTRACION concilia los pagos que los clientes hacen por las órdenes (pagosOrdenes, más abajo): lee las órdenes, los técnicos y los reportes (sin
    // escribir nada de eso) y escribe solo esos pagos. El ADMIN también los trabaja.
    function isAdministracionRole(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'ADMINISTRACION';
    }

    function llevaAdministracion(appId) {
      return isAdminUser(appId) || isAdministracionRole(appId);
    }

    // El nombre de usuario de quien escribe: lo que queda en "por" de cada registro de Finanzas.
    function usuarioFinanzas(appId) {
      return get(profilePath(appId)).data.get('username', '');
    }

    // Cambiar `aplicado` (lo que ya se descontó de un adelanto, un descuento o un bono en pagos) solo vale junto a un pago del mismo técnico: al pagar, el pago se crea en el mismo lote
    // (y trae ese adelanto o ajuste en su lista, `lista`); al anular, ese mismo lote anula el pago. `pagoId` dice cuál. Así nadie borra un descuento ni un adelanto sin dejar el pago que
    // lo respalda. Son siempre los mismos dos documentos (el pago y el perfil): no suman llamadas aunque el lote traiga muchos adelantos.
    function aplicaEnPago(appId, lista) {
      let pago = /databases/$(database)/documents/artifacts/$(appId)/public/data/pagosTecnicos/$(request.resource.data.pagoId);
      return request.resource.data.pagoId is string && request.resource.data.pagoId.size() > 0 && request.resource.data.pagoId.size() <= 100
        && (
          (request.resource.data.aplicado > resource.data.aplicado
            && !exists(pago) && existsAfter(pago)
            && getAfter(pago).data.tecnico == resource.data.tecnico
            && getAfter(pago).data.get(lista, []).size() > 0)
          || (request.resource.data.aplicado <= resource.data.aplicado
            && exists(pago) && get(pago).data.get('anulado', false) == false
            && getAfter(pago).data.get('anulado', false) == true
            && getAfter(pago).data.tecnico == resource.data.tecnico)
        );
    }

    // Los nombres (normalizados) con que una PROMOTORA aparece en las plantillas; ve las instalaciones con alguno.
    function promotoraClaves(appId) {
      return get(profilePath(appId)).data.get('promotoraClaves', []);
    }

    // Un perfil PROMOTORA con "ve todas" (ventas) lee las instalaciones de todas las promotoras. Solo lo escribe el ADMIN.
    function promotoraVeTodas(appId) {
      return get(profilePath(appId)).data.get('verTodasInstalaciones', false) == true;
    }

    function tecnicoAsociado(appId) {
      return get(profilePath(appId)).data.tecnicoAsociado;
    }

    function canCerrar(appId) {
      return isAdminUser(appId) || (isActiveUser(appId) && get(profilePath(appId)).data.puedeCerrar == true);
    }

    match /artifacts/{appId}/public/data/users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdminUser(appId));
      allow list: if isAdminUser(appId);
      allow create, delete: if isAdminUser(appId);
      // Registro de token de push: cada usuario puede agregar el suyo a su
      // propio perfil (arrayUnion), sin tocar ningún otro campo.
      allow update: if isAdminUser(appId)
        || (
          isSignedIn() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens'])
        );
    }

    match /artifacts/{appId}/public/data/technicians/{docId} {
      // TECNICO solo puede ver su propio técnico vinculado (el cliente debe
      // hacer where('name','==', tecnicoAsociado); sin eso el list se rechaza).
      // Una PROMOTORA con permiso de crear ventas lee la lista para emparejar el "Instalador:" de la plantilla con un técnico.
      allow read: if isAdminUser(appId) || isUsuarioRole(appId) || isAlmacenRole(appId) || isFinanzasRole(appId) || isAdministracionRole(appId)
        || (isPromotoraRole(appId) && get(profilePath(appId)).data.get('puedeCrearVentas', false) == true)
        || (isTecnicoRole(appId) && resource.data.name == tecnicoAsociado(appId));

      // Alta/baja/color son de ADMIN. El toggle de activo/inactivo (pantalla
      // principal) también lo puede usar USUARIO (operativo, no estructural) y
      // cada TECNICO sobre su propio técnico vinculado, nunca sobre otro.
      // "Nombre en el inventario" (tecnicoInventario: con qué nombre conoce al técnico el inventario del almacén) solo lo
      // escribe quien gestiona los envíos al inventario (veInventario, más abajo): ningún otro ADMIN lo pone ni lo cambia.
      allow create: if isAdminUser(appId) && (!('tecnicoInventario' in request.resource.data) || veInventario(appId));
      allow delete: if isAdminUser(appId);
      allow update: if (isAdminUser(appId) && (veInventario(appId) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tecnicoInventario'])))
        || (
          (isUsuarioRole(appId) || (isTecnicoRole(appId) && resource.data.name == tecnicoAsociado(appId)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo', 'activoUpdatedBy', 'activoUpdatedByRole', 'activoUpdatedAt'])
        );
    }

    // Registro de cuándo se activa o desactiva cada técnico (un documento por cambio; lo escribe la app junto al cambio de "activo").
    // Solo se agrega: nadie lo edita ni lo borra. Lo lee la oficina; el TECNICO solo agrega los suyos.
    match /artifacts/{appId}/public/data/technicianLog/{docId} {
      allow read: if canCerrar(appId) || isAdminUser(appId) || isUsuarioRole(appId);
      allow create: if (isAdminUser(appId) || isUsuarioRole(appId) || (isTecnicoRole(appId) && request.resource.data.get('tecnico', '') == tecnicoAsociado(appId)))
        && request.resource.data.keys().hasOnly(['tecnicoId', 'tecnico', 'activo', 'en', 'dia', 'por', 'rol'])
        && request.resource.data.tecnico is string && request.resource.data.tecnico.size() > 0
        && request.resource.data.activo is bool
        && request.resource.data.en is int && request.resource.data.dia is string
        && request.resource.data.rol == get(profilePath(appId)).data.role;
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/tickets/{docId} {
      // Venta que carga una PROMOTORA con permiso de crear ventas. Solo estos campos (nada de cobro ni de la instalación), el código
      // sin número ("IS") como lo arma la app, creada a su nombre, y con un promotor que ella pueda ver después: uno de sus nombres o,
      // con "ve todas" (ventas), cualquiera. El técnico solo puede ser el de la plantilla: uno registrado (ventaTecnicoId es su documento y su nombre debe ser el del técnico), y marcado como venta suya
      // (ventaTecnico igual a tecnico); sin técnico, ninguno. La oficina numera la orden y le avisa al técnico cuando la ve.
      function creaVentaPromotora(appId) {
        let orden = request.resource.data;
        return isPromotoraRole(appId)
          && get(profilePath(appId)).data.get('puedeCrearVentas', false) == true
          && orden.keys().hasOnly(['fecha', 'fechaProgramada', 'codigo', 'nombre', 'cedula', 'tipoDocumento', 'direccion', 'telefono', 'nap', 'napCoordenadas', 'ubicacion', 'tipoTrabajo', 'falla', 'tecnico', 'ventaTecnico', 'ventaTecnicoId', 'observacion', 'observacionInterna', 'estado', 'plantillaOriginal', 'promotora', 'promotoraClave', 'creado', 'creadoNombre', 'createdAt', 'historialEdiciones', 'isAsignado', 'ventaPromotora'])
          && orden.tipoTrabajo == 'INSTALACIÓN'
          && orden.estado == 'PENDIENTE'
          && orden.get('ventaTecnico', '') == orden.get('tecnico', '')
          && (
            (orden.get('tecnico', '') == '' && orden.get('ventaTecnicoId', '') == '')
            || (orden.get('ventaTecnicoId', '') != ''
                && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/technicians/$(orden.ventaTecnicoId)).data.name == orden.tecnico)
          )
          && orden.get('isAsignado', false) == false
          && orden.get('ventaPromotora', false) == true
          && orden.get('historialEdiciones', []).size() == 0
          && orden.get('codigo', '').matches('^I[A-Z]{1,2}$')
          && orden.get('creado', '') == get(profilePath(appId)).data.get('username', '')
          && orden.get('promotoraClave', '') != ''
          && (promotoraVeTodas(appId) || orden.get('promotoraClave', '') in promotoraClaves(appId));
      }

      // TECNICO solo ve/edita sus propios tickets (los que tienen su nombre en
      // "tecnico"); el cliente debe hacer el query con where('tecnico','==', ...)
      // igualado a este valor, si no el list completo es rechazado.
      // ALMACEN cuenta el material de todas las órdenes; PROMOTORA solo ve las instalaciones que vendió ella (su
      // promotoraClave está entre las suyas). El cliente debe consultar con where('tipoTrabajo','==','INSTALACIÓN') y
      // where('promotoraClave','==', una de sus claves), si no la lectura es rechazada.
      allow read: if isAdminUser(appId) || isUsuarioRole(appId) || isAlmacenRole(appId) || isFinanzasRole(appId) || isAdministracionRole(appId)
        || (isPromotoraRole(appId) && resource.data.tipoTrabajo == 'INSTALACIÓN' && (promotoraVeTodas(appId) || resource.data.get('promotoraClave', '') in promotoraClaves(appId)))
        // Ventas (el PROMOTOR con "ve todas") también sigue las averías de tipo LOS: solo esas, y solo ellas.
        || (isPromotoraRole(appId) && promotoraVeTodas(appId) && resource.data.tipoTrabajo == 'AVERÍA' && resource.data.get('falla', '') == 'LOS')
        // INFRAESTRUCTURA ve las instalaciones ya finalizadas (con su NAP y puerto); la consulta debe pedir tipoTrabajo y estado.
        || (isInfraestructuraRole(appId) && resource.data.tipoTrabajo == 'INSTALACIÓN' && resource.data.estado == 'FINALIZADO')
        || (isTecnicoRole(appId) && resource.data.tecnico == tecnicoAsociado(appId));

      // Crear órdenes es acción de ADMIN/USUARIO; TECNICO no tiene esa UI. Una PROMOTORA con permiso (puedeCrearVentas, lo
      // marca el ADMIN) solo crea ventas: instalaciones pendientes, sin técnico y a nombre de su promotor.
      allow create: if isAdminUser(appId) || isUsuarioRole(appId) || creaVentaPromotora(appId);

      // TECNICO: solo su propio ticket y solo los campos de su trabajo (los que
      // tiene habilitados en Pre-finalizar / Detalles). El estado solo puede pasar
      // de PENDIENTE a PRE-FINALIZADO: nunca FINALIZADO ni CANCELADO, ni
      // reabrir una orden. El historial solo crece: no puede borrar entradas.
      // Una orden ya finalizada no cambia su cierre: ni la hora de finalización ni el cobro. Si dos personas finalizan la misma orden a la vez,
      // la segunda escritura llega con la orden ya FINALIZADA y se rechaza aquí (la app, además, lo evita con una transacción).
      function noPisaElCierre() {
        return !(resource.data.get('estado', '') == 'FINALIZADO'
          && request.resource.data.get('estado', '') == 'FINALIZADO'
          && (request.resource.data.get('finalizadoEn', null) != resource.data.get('finalizadoEn', null)
            || request.resource.data.get('cobroBs', null) != resource.data.get('cobroBs', null)
            || request.resource.data.get('cobroTipo', null) != resource.data.get('cobroTipo', null)));
      }

      allow update: if ((isAdminUser(appId) || isUsuarioRole(appId)) && noPisaElCierre())
        || (
          isTecnicoRole(appId)
          && resource.data.tecnico == tecnicoAsociado(appId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'nap', 'napCoordenadas', 'potenciaDbm', 'potencia1490Dbm', 'observacion', 'observacionInterna', 'observacionTecnico', 'consultaCobro', 'tipoVisita', 'metrosCable', 'conectorExterno', 'conectorInterno', 'conectoresUsados', 'serialEquipo', 'tipoEquipoNuevo', 'instalacion', 'enCamino', 'salioEn', 'llegoEn', 'prefinalizadoEn', 'historialEdiciones'])
          // Escalar a infraestructura desde el técnico: desactivado por ahora (solo la oficina escala). Para reactivarlo, agregar
          // 'infraestructura' a la lista de arriba y esta condición (el técnico solo deja la orden esperando, a su nombre y con motivo):
          // && (
          //   !request.resource.data.diff(resource.data).affectedKeys().hasAny(['infraestructura'])
          //   || (
          //     resource.data.estado == 'PENDIENTE'
          //     && resource.data.get('infraestructura', {}).get('activa', false) != true
          //     && request.resource.data.infraestructura.keys().hasOnly(['activa', 'motivo', 'por', 'origen', 'en', 'tecnico'])
          //     && request.resource.data.infraestructura.activa == true
          //     && request.resource.data.infraestructura.origen == 'TECNICO'
          //     && request.resource.data.infraestructura.tecnico == tecnicoAsociado(appId)
          //     && request.resource.data.infraestructura.motivo is string
          //     && request.resource.data.infraestructura.motivo.size() > 0
          //     && request.resource.data.infraestructura.motivo.size() <= 300
          //     && request.resource.data.infraestructura.en is int
          //   )
          // )
          // Las horas del ciclo (reporte de esperas) son números o null; asignadoEn y primerAsignadoEn solo los escribe la oficina.
          && (request.resource.data.get('salioEn', null) == null || request.resource.data.salioEn is int)
          && (request.resource.data.get('llegoEn', null) == null || request.resource.data.llegoEn is int)
          && (request.resource.data.get('prefinalizadoEn', null) == null || request.resource.data.prefinalizadoEn is int)
          // "En camino" / "En sitio": solo a su nombre (o null para cancelarlo), nunca en nombre de otro técnico.
          && (request.resource.data.get('enCamino', null) == null
               || request.resource.data.enCamino.tecnico == tecnicoAsociado(appId))
          && (
            request.resource.data.estado == resource.data.estado
            || (resource.data.estado == 'PENDIENTE' && request.resource.data.estado == 'PRE-FINALIZADO')
          )
          && request.resource.data.get('historialEdiciones', []).hasAll(resource.data.get('historialEdiciones', []))
        );

      // El flujo normal da de baja una orden cancelándola (estado CANCELADO, con su motivo). El borrado
      // físico real solo lo usa el proceso de cierre (Reportes), reservado a canCerrar.
      allow delete: if canCerrar(appId);
    }

    // Aviso de "alguien está revisando esta orden": un documento por orden y persona ("<id de la orden>__<usuario>"), con vencimiento de pocos
    // minutos (la app lo renueva mientras el modal sigue abierto y lo borra al cerrarlo). Solo la oficina lo lee y escribe, solo a su nombre,
    // y nunca vence a más de 10 minutos. No bloquea nada: avisa. Un aviso vencido lo puede borrar cualquiera de la oficina (limpieza).
    match /artifacts/{appId}/public/data/bloqueosOrden/{docId} {
      function usuarioActual(appId) {
        return get(profilePath(appId)).data.get('username', '');
      }
      allow read: if isAdminUser(appId) || isUsuarioRole(appId);
      allow create, update: if (isAdminUser(appId) || isUsuarioRole(appId))
        && request.resource.data.keys().hasOnly(['ticketId', 'por', 'nombre', 'desde', 'venceEn'])
        && request.resource.data.por == usuarioActual(appId)
        && request.resource.data.por is string && request.resource.data.por.size() > 0
        && request.resource.data.ticketId is string && request.resource.data.ticketId.size() > 0
        && docId == request.resource.data.ticketId + '__' + request.resource.data.por
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 100
        && request.resource.data.desde is int && request.resource.data.venceEn is int
        && request.resource.data.venceEn <= request.time.toMillis() + 600000;
      // `resource == null`: borrar un aviso que ya no existe no es un error (si no, el navegador que lo intenta lo reintenta sin fin: cada intento fallido cuesta una lectura del perfil).
      allow delete: if (isAdminUser(appId) || isUsuarioRole(appId))
        && (resource == null || resource.data.get('por', '') == usuarioActual(appId) || resource.data.get('venceEn', 0) < request.time.toMillis());
    }

    // Registro de VN y TA (la pestaña VN/TA de la hoja del departamento): se llena a mano, una fila por documento. Lo leen y lo escriben la oficina
    // (ADMIN y USUARIO). Al crear queda quién lo registró (creadoPor, el usuario de quien escribe); el código, el tipo, quién lo creó y cuándo no
    // cambian después. Borrar: el ADMIN o quien lo registró. FINANZAS lo lee para pagar al técnico que apoyó: al pagar marca la fila (pagoId, pagadoEn) y al
    // anular el pago la desmarca; mientras está pagada la oficina no la edita ni la borra (el pago ya cuenta ese técnico y esa fecha).
    match /artifacts/{appId}/public/data/registroVnTa/{docId} {
      function usuarioDe(appId) {
        return get(profilePath(appId)).data.get('username', '');
      }
      function filaValida() {
        let r = request.resource.data;
        return r.keys().hasOnly(['codigo', 'trabajo', 'tecnico', 'fecha', 'observacion', 'operador', 'creadoPor', 'creadoEn', 'actualizadoEn', 'pagoId', 'pagadoEn'])
          && r.trabajo in ['VN', 'TA']
          && r.codigo is string
          && ((r.trabajo == 'VN' && r.codigo.matches('^VAN[0-9]{2,}$')) || (r.trabajo == 'TA' && r.codigo.matches('^TA[0-9]{2,}$')))
          && r.fecha is string && r.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && r.tecnico is string && r.tecnico.size() <= 100
          && r.observacion is string && r.observacion.size() <= 500
          && r.operador is string && r.operador.size() > 0 && r.operador.size() <= 100
          && r.creadoPor is string && r.creadoEn is int && r.actualizadoEn is int;
      }
      function sinPagar() {
        return resource.data.get('pagoId', '') == '';
      }
      allow read: if isAdminUser(appId) || isUsuarioRole(appId) || isFinanzasRole(appId);
      allow create: if (isAdminUser(appId) || isUsuarioRole(appId))
        && filaValida()
        && !('pagoId' in request.resource.data) && !('pagadoEn' in request.resource.data)
        && request.resource.data.creadoPor == usuarioDe(appId) && usuarioDe(appId) != '';
      allow update: if ((isAdminUser(appId) || isUsuarioRole(appId))
        && sinPagar()
        && filaValida()
        && request.resource.data.get('pagoId', '') == ''
        && request.resource.data.codigo == resource.data.codigo
        && request.resource.data.trabajo == resource.data.trabajo
        && request.resource.data.creadoPor == resource.data.creadoPor
        && request.resource.data.creadoEn == resource.data.creadoEn)
        || (llevaFinanzas(appId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pagoId', 'pagadoEn'])
          && request.resource.data.pagoId is string && request.resource.data.pagoId.size() <= 100
          && request.resource.data.pagadoEn is int);
      allow delete: if sinPagar() && (isAdminUser(appId) || (isUsuarioRole(appId) && resource.data.creadoPor == usuarioDe(appId)));
    }

    match /artifacts/{appId}/public/data/reports/{docId} {
      // ALMACEN lee los reportes para sumar el material de las órdenes ya archivadas; FINANZAS, para los cobros y pagos de las ya archivadas.
      allow read: if canCerrar(appId) || isAlmacenRole(appId) || isFinanzasRole(appId) || isAdministracionRole(appId)
        // INFRAESTRUCTURA lee solo los reportes de cierre (donde están las instalaciones archivadas); la consulta debe pedir tipoReporte.
        || (isInfraestructuraRole(appId) && resource.data.get('tipoReporte', '') == 'CIERRE');
      allow write: if canCerrar(appId);
    }

    // Instalaciones que INFRAESTRUCTURA ya anotó en sus registros: un documento por mes ("2026-10") con un mapa "marcas" (id de la orden ->
    // quién y cuándo). Un documento por mes (y no uno por orden) para leer solo dos al abrir el módulo. Lo marcan INFRAESTRUCTURA y ADMIN,
    // y solo el campo "marcas": nunca se borra el documento.
    match /artifacts/{appId}/public/data/infraAnotadas/{mes} {
      allow read: if isAdminUser(appId) || isInfraestructuraRole(appId);
      allow create, update: if mes.matches('[0-9]{4}-[0-9]{2}')
        && (isAdminUser(appId) || isInfraestructuraRole(appId))
        && request.resource.data.keys().hasOnly(['marcas'])
        && request.resource.data.marcas is map;
    }

    // Resumen liviano de las instalaciones cerradas de los últimos días (lo escribe el cierre del día, manual o
    // automático): lo único que la PROMOTORA ve de una instalación después de que sale de la lista de órdenes.
    match /artifacts/{appId}/public/data/historialInstalaciones/{docId} {
      // PROMOTORA: solo las de su promotora (resumenInstalacion guarda su promotoraClave).
      allow read: if canCerrar(appId) || (isPromotoraRole(appId) && (promotoraVeTodas(appId) || resource.data.get('promotoraClave', '') in promotoraClaves(appId)));
      allow write: if canCerrar(appId);
    }

    // Totales del mes de instalaciones y averías LOS finalizadas y canceladas (un documento por mes, "2026-10"). Los suma el cierre del
    // día: el automático desde el Worker (cuenta de servicio, no pasa por estas reglas) y el manual desde la app de quien cierra, que
    // solo puede sumar (los cuatro contadores, enteros, que nunca bajan). Los ve la oficina que cierra y el perfil de ventas.
    match /artifacts/{appId}/public/data/estadisticasMensuales/{mes} {
      function contadorSube(campo) {
        return request.resource.data.get(campo, 0) is int
          && request.resource.data.get(campo, 0) >= (resource == null ? 0 : resource.data.get(campo, 0));
      }
      allow read: if canCerrar(appId) || (isPromotoraRole(appId) && promotoraVeTodas(appId));
      allow create, update: if canCerrar(appId)
        && mes.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['instalacionesFinalizadas', 'instalacionesCanceladas', 'losResueltas', 'losCanceladas'])
        && contadorSube('instalacionesFinalizadas') && contadorSube('instalacionesCanceladas')
        && contadorSube('losResueltas') && contadorSube('losCanceladas');
      allow delete: if false;
    }

    // Quien ve y gestiona los envíos al inventario del otro sistema: solo estos usuarios (por nombre de usuario de la app).
    // Mantener sincronizado con USUARIOS_INVENTARIO de src/utils/accesoInventario.js (lo comprueba `npm run test:inventario`).
    function veInventario(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.get('username', '') in ['lfernandez'];
    }

    // Estado de cada envío al inventario del otro sistema (un documento por orden aprobada; lo escribe el Worker con su
    // cuenta de servicio). Solo lo ven y gestionan los usuarios de veInventario. Quien aprueba una orden deja, nada más,
    // la marca mínima "pendiente" sin datos de la orden: el Worker lee la orden él mismo, así que una marca no puede
    // inventar lo que se envía.
    match /artifacts/{appId}/public/data/telecomEnvios/{docId} {
      allow read: if veInventario(appId);
      allow create: if (isAdminUser(appId) || isUsuarioRole(appId))
        && request.resource.data.keys().hasOnly(['ticketId', 'estado', 'intentos'])
        && request.resource.data.ticketId == docId
        && request.resource.data.estado == 'PENDIENTE'
        && request.resource.data.intentos == 0;
      // Descartar una alerta: pasa a DESCARTADO (queda el registro de lo que no se envió); no se borra nada.
      allow update: if veInventario(appId)
        && resource.data.estado in ['SERIAL_NO_ENCONTRADO', 'SERIAL_YA_INSTALADO', 'EQUIPO_NO_ASIGNADO', 'SIN_SERIAL', 'TECNICO_NO_VINCULADO', 'TECNICO_NO_ENCONTRADO', 'TECNICO_INACTIVO', 'EQUIPO_OTRO_TECNICO', 'ERROR']
        && request.resource.data.estado == 'DESCARTADO'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizadoEn', 'descartadoPor']);
    }

    // --- Finanzas (pago a técnicos): lo escriben FINANZAS y el ADMIN, siempre a nombre de quien lo hace (por) ---

    // Lo que se le paga al técnico por cada concepto, en dólares: un solo documento ("actual").
    match /artifacts/{appId}/public/data/tarifasPago/{docId} {
      function tarifaValida(campo) {
        let v = request.resource.data.get(campo, null);
        return (v is int || v is float) && v >= 0 && v <= 100000;
      }
      allow read: if llevaFinanzas(appId);
      allow create, update: if llevaFinanzas(appId) && docId == 'actual'
        && request.resource.data.keys().hasOnly(['INSTALACION', 'VISITA', 'AVERIA', 'MUDANZA_INTERNA', 'MUDANZA_EXTERNA', 'VALIDACION_NAP', 'TRABAJO_ADICIONAL', 'RECABLEADO', 'LOW_SIGNAL', 'CAMBIO_EQUIPO', 'por', 'en'])
        && tarifaValida('INSTALACION') && tarifaValida('AVERIA')
        && (!('VISITA' in request.resource.data) || tarifaValida('VISITA'))
        && (!('MUDANZA_INTERNA' in request.resource.data) || tarifaValida('MUDANZA_INTERNA'))
        && (!('MUDANZA_EXTERNA' in request.resource.data) || tarifaValida('MUDANZA_EXTERNA'))
        && (!('VALIDACION_NAP' in request.resource.data) || tarifaValida('VALIDACION_NAP'))
        && (!('TRABAJO_ADICIONAL' in request.resource.data) || tarifaValida('TRABAJO_ADICIONAL'))
        && (!('RECABLEADO' in request.resource.data) || tarifaValida('RECABLEADO'))
        && (!('LOW_SIGNAL' in request.resource.data) || tarifaValida('LOW_SIGNAL'))
        && (!('CAMBIO_EQUIPO' in request.resource.data) || tarifaValida('CAMBIO_EQUIPO'))
        && request.resource.data.por == usuarioFinanzas(appId)
        && request.resource.data.en is int;
      allow delete: if false;
    }

    // El tipo (interna o externa) de una mudanza que se hizo antes de que la orden tuviera ese campo y que ya está en un cierre (los cierres no se editan): Finanzas
    // lo elige aquí, con el id de la orden, para saber con qué precio se paga. No toca la orden.
    match /artifacts/{appId}/public/data/tiposMudanza/{docId} {
      allow read: if llevaFinanzas(appId);
      allow create, update: if llevaFinanzas(appId)
        && request.resource.data.keys().hasOnly(['tipo', 'por', 'en'])
        && request.resource.data.tipo in ['INTERNA', 'EXTERNA']
        && request.resource.data.por == usuarioFinanzas(appId)
        && request.resource.data.en is int;
      allow delete: if false;
    }

    // Un pago a un técnico por un periodo. Solo se crea; después solo se puede anular (queda el registro y las órdenes vuelven a estar por pagar).
    match /artifacts/{appId}/public/data/pagosTecnicos/{docId} {
      function pagoValido() {
        let p = request.resource.data;
        return p.keys().hasOnly(['tecnico', 'desde', 'hasta', 'cantidades', 'tarifas', 'total', 'cantidadOrdenes', 'nota', 'por', 'creadoEn', 'anulado', 'tasa', 'descuento', 'neto', 'bonos', 'adelantos', 'ajustes', 'descuentosManuales', 'moneda', 'forma', 'banco', 'referencia', 'pagadoEn', 'montoPagado', 'notificado'])
          && (!('tasa' in p) || ((p.tasa is int || p.tasa is float) && p.tasa > 0 && p.tasa < 100000000))
          && (!('bonos' in p) || ((p.bonos is int || p.bonos is float) && p.bonos > 0 && p.bonos <= 100000))
          && (!('descuento' in p) || ((p.descuento is int || p.descuento is float) && p.descuento >= 0 && p.descuento <= p.total + p.get('bonos', 0)))
          && (!('neto' in p) || ((p.neto is int || p.neto is float) && p.neto >= 0 && p.neto <= p.total + p.get('bonos', 0)))
          && (!('adelantos' in p) || (p.adelantos is list && p.adelantos.size() <= 50))
          && (!('ajustes' in p) || (p.ajustes is list && p.ajustes.size() <= 50))
          && (!('descuentosManuales' in p) || (p.descuentosManuales is list && p.descuentosManuales.size() <= 50))
          && (!('moneda' in p) || p.moneda in ['BS', 'USD'])
          && (!('forma' in p) || (p.forma is string && p.forma.size() > 0 && p.forma.size() <= 40))
          && (!('banco' in p) || (p.banco is string && p.banco.size() <= 40))
          && (!('referencia' in p) || (p.referencia is string && p.referencia.size() <= 40))
          && (!('pagadoEn' in p) || p.pagadoEn is int)
          && (!('montoPagado' in p) || ((p.montoPagado is int || p.montoPagado is float) && p.montoPagado >= 0))
          && (!('notificado' in p) || p.notificado is bool)
          && p.tecnico is string && p.tecnico.size() > 0 && p.tecnico.size() <= 100
          && p.desde is string && p.desde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && p.hasta is string && p.hasta.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && p.cantidades is map && p.tarifas is map
          && (p.total is int || p.total is float) && p.total >= 0 && (p.total > 0 || p.get('bonos', 0) > 0)
          && p.cantidadOrdenes is int && p.cantidadOrdenes >= 0 && p.cantidadOrdenes <= 450 && (p.cantidadOrdenes > 0 || p.get('bonos', 0) > 0)
          && p.nota is string && p.nota.size() <= 300
          && p.por == usuarioFinanzas(appId) && p.por != ''
          && p.creadoEn is int
          && p.anulado == false;
      }
      // El técnico lee solo los suyos (para ver el aviso de pago con la app abierta).
      allow read: if llevaFinanzas(appId) || (isTecnicoRole(appId) && resource.data.tecnico == tecnicoAsociado(appId));
      allow create: if llevaFinanzas(appId) && pagoValido();
      allow update: if llevaFinanzas(appId)
        && resource.data.get('anulado', false) == false
        && request.resource.data.anulado == true
        && request.resource.data.anuladoPor == usuarioFinanzas(appId)
        && request.resource.data.anuladoEn is int
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anulado', 'anuladoPor', 'anuladoEn']);
      allow delete: if false;
    }

    // Revisión de pagos: la barrera entre las órdenes y Finanzas. Un documento por orden (el id es el de ordenesPagadas): el administrador la aprueba, retiene o excluye, y
    // puede corregir su técnico o su concepto de pago. Finanzas solo ve las aprobadas. Solo escribe el ADMIN, siempre a su nombre (por); retener y excluir exigen motivo; el
    // administrador puede borrar el documento para volver a empezar. Lo leen ADMIN y FINANZAS.
    match /artifacts/{appId}/public/data/revisionPagos/{docId} {
      function revisionValida() {
        let r = request.resource.data;
        return r.keys().hasOnly(['estado', 'motivo', 'firma', 'dia', 'codigo', 'tecnico', 'concepto', 'tecnicoCorregido', 'conceptoCorregido', 'descuento', 'descuentoDe', 'garantiaSinDescuento', 'por', 'en', 'historial'])
          && (!('descuento' in r) || ((r.descuento is int || r.descuento is float) && r.descuento >= 0 && r.descuento <= 100000))
          && (!('descuentoDe' in r) || (r.descuentoDe is map && r.descuentoDe.keys().hasOnly(['id', 'codigo', 'tecnico']) && r.descuentoDe.id is string && r.descuentoDe.id.size() > 0 && r.descuentoDe.id.size() <= 200
            && r.descuentoDe.codigo is string && r.descuentoDe.codigo.size() <= 40 && r.descuentoDe.tecnico is string && r.descuentoDe.tecnico.size() > 0 && r.descuentoDe.tecnico.size() <= 100))
          && (!('garantiaSinDescuento' in r) || (r.garantiaSinDescuento is string && r.garantiaSinDescuento.size() > 0 && r.garantiaSinDescuento.size() <= 300))
          && r.estado in ['PENDIENTE', 'APROBADA', 'RETENIDA', 'EXCLUIDA']
          && r.motivo is string && r.motivo.size() <= 300
          && (!(r.estado in ['RETENIDA', 'EXCLUIDA']) || r.motivo.size() > 0)
          && r.firma is string && r.firma.size() > 0 && r.firma.size() <= 40
          && r.dia is string && r.dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && r.codigo is string && r.codigo.size() <= 40
          && r.tecnico is string && r.tecnico.size() <= 100
          && r.concepto is string && r.concepto.size() <= 30
          && r.tecnicoCorregido is string && r.tecnicoCorregido.size() <= 100
          && r.conceptoCorregido is string && (r.conceptoCorregido == '' || r.conceptoCorregido in ['INSTALACION', 'AVERIA', 'MUDANZA_INTERNA', 'MUDANZA_EXTERNA', 'VALIDACION_NAP', 'TRABAJO_ADICIONAL', 'RECABLEADO', 'LOW_SIGNAL', 'CAMBIO_EQUIPO'])
          && r.por == usuarioFinanzas(appId) && r.por != ''
          && r.en is int
          && r.historial is list && r.historial.size() <= 30;
      }
      allow read: if llevaFinanzas(appId);
      allow create, update: if isAdminUser(appId) && revisionValida();
      allow delete: if isAdminUser(appId);
    }

    // Descuentos y bonos por una orden que el administrador pasó de un técnico a otro al revisarla (siempre en dólares). Los crea el ADMIN al aprobar la orden (el id sale de la
    // orden: `desc_` o `bono_` más su clave) y los borra si la deshace, mientras no se haya aplicado nada. `aplicado` es lo que ya entró en pagos: Finanzas lo sube al pagar y lo baja
    // al anular el pago, nunca más que `monto`. El técnico lee solo los suyos.
    match /artifacts/{appId}/public/data/ajustesTecnicos/{docId} {
      function ajusteValido() {
        let a = request.resource.data;
        return a.keys().hasOnly(['tecnico', 'tipo', 'monto', 'aplicado', 'clave', 'codigo', 'claveOrigen', 'codigoOrigen', 'de', 'a', 'por', 'creadoEn', 'notificado'])
          && (!('claveOrigen' in a) || (a.claveOrigen is string && a.claveOrigen.size() > 0 && a.claveOrigen.size() <= 200))
          && (!('codigoOrigen' in a) || (a.codigoOrigen is string && a.codigoOrigen.size() <= 40))
          && a.tecnico is string && a.tecnico.size() > 0 && a.tecnico.size() <= 100
          && a.tipo in ['DESCUENTO', 'BONO']
          && (a.monto is int || a.monto is float) && a.monto > 0 && a.monto <= 100000
          && a.aplicado == 0
          && a.clave is string && a.clave.size() > 0 && a.clave.size() <= 200
          && a.codigo is string && a.codigo.size() <= 40
          && a.de is string && a.de.size() > 0 && a.de.size() <= 100
          && a.a is string && a.a.size() > 0 && a.a.size() <= 100 && a.de != a.a
          && a.tecnico == (a.tipo == 'DESCUENTO' ? a.de : a.a)
          && a.por == usuarioFinanzas(appId) && a.por != ''
          && a.creadoEn is int
          && a.notificado is bool;
      }
      allow read: if llevaFinanzas(appId) || (isTecnicoRole(appId) && resource.data.tecnico == tecnicoAsociado(appId));
      allow create: if isAdminUser(appId) && ajusteValido();
      // El ADMIN vuelve a guardar el mismo ajuste (aprobar otra vez) mientras nada se haya aplicado; Finanzas solo mueve `aplicado`.
      allow update: if (isAdminUser(appId) && resource.data.aplicado == 0 && ajusteValido())
        || (llevaFinanzas(appId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aplicado', 'pagoId'])
          && (request.resource.data.aplicado is int || request.resource.data.aplicado is float)
          && request.resource.data.aplicado >= 0 && request.resource.data.aplicado <= resource.data.monto
          && aplicaEnPago(appId, 'ajustes'));
      allow delete: if isAdminUser(appId) && resource.data.aplicado == 0;
    }

    // Adelantos a un técnico (siempre en dólares): se restan de lo que tiene por pagar. `aplicado` es lo que ya se descontó en pagos (sube al pagar, baja al anular el
    // pago, nunca pasa de `monto`); un adelanto solo se anula si no se ha descontado nada. El técnico lee solo los suyos.
    match /artifacts/{appId}/public/data/adelantosTecnicos/{docId} {
      function adelantoValido() {
        let a = request.resource.data;
        return a.keys().hasOnly(['tecnico', 'monto', 'aplicado', 'forma', 'banco', 'referencia', 'pagadoEn', 'nota', 'por', 'creadoEn', 'anulado', 'notificado'])
          && a.tecnico is string && a.tecnico.size() > 0 && a.tecnico.size() <= 100
          && (a.monto is int || a.monto is float) && a.monto > 0 && a.monto <= 100000
          && a.aplicado == 0
          && a.forma in ['Zelle', 'Pago móvil', 'Transferencia', 'Efectivo', 'Otro']
          && a.banco is string && a.banco.size() <= 40
          && a.referencia is string && a.referencia.size() <= 40
          && a.pagadoEn is int && a.creadoEn is int
          && a.nota is string && a.nota.size() <= 300
          && a.por == usuarioFinanzas(appId) && a.por != ''
          && a.anulado == false
          && a.notificado is bool;
      }
      allow read: if llevaFinanzas(appId) || (isTecnicoRole(appId) && resource.data.tecnico == tecnicoAsociado(appId));
      allow create: if llevaFinanzas(appId) && adelantoValido();
      allow update: if llevaFinanzas(appId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aplicado', 'pagoId'])
          && (request.resource.data.aplicado is int || request.resource.data.aplicado is float)
          && request.resource.data.aplicado >= 0 && request.resource.data.aplicado <= resource.data.monto
          && resource.data.anulado == false
          && aplicaEnPago(appId, 'adelantos'))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anulado', 'anuladoPor', 'anuladoEn'])
          && resource.data.aplicado == 0 && resource.data.anulado == false
          && request.resource.data.anulado == true
          && request.resource.data.anuladoPor == usuarioFinanzas(appId)
          && request.resource.data.anuladoEn is int));
      allow delete: if false;
    }

    // Descuentos con motivo que Finanzas o el ADMIN le ponen a un técnico (siempre en dólares, sin orden asociada): se restan de lo que tiene por pagar, igual que un adelanto. `aplicado` es lo que ya se
    // descontó en pagos (sube al pagar, baja al anular el pago, nunca pasa de `monto`); un descuento solo se anula si no se ha descontado nada, y sin motivo no se guarda. El técnico lee solo los suyos.
    match /artifacts/{appId}/public/data/descuentosTecnicos/{docId} {
      function descuentoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tecnico', 'monto', 'aplicado', 'motivo', 'por', 'creadoEn', 'anulado', 'notificado', 'desde', 'cuota', 'cuotas', 'totalPlan'])
          && d.tecnico is string && d.tecnico.size() > 0 && d.tecnico.size() <= 100
          && (d.monto is int || d.monto is float) && d.monto > 0 && d.monto <= 100000
          && d.aplicado == 0
          && d.motivo is string && d.motivo.size() > 0 && d.motivo.size() <= 300
          && d.por == usuarioFinanzas(appId) && d.por != ''
          && d.creadoEn is int
          && d.anulado == false
          && d.notificado is bool
          // Programado: `desde` (día de Caracas, "AAAA-MM-DD") y, si va en cuotas, cuál es y de cuántas (2 a 12) con el total del plan.
          && (!('desde' in d) || (d.desde is string && d.desde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('cuotas' in d) || ('desde' in d && 'cuota' in d && 'totalPlan' in d
            && d.cuotas is int && d.cuotas >= 2 && d.cuotas <= 12 && d.cuota is int && d.cuota >= 1 && d.cuota <= d.cuotas
            && (d.totalPlan is int || d.totalPlan is float) && d.totalPlan >= d.monto && d.totalPlan <= 1200000))
          && (!('cuota' in d) || 'cuotas' in d)
          && (!('totalPlan' in d) || 'cuotas' in d);
      }
      allow read: if llevaFinanzas(appId) || (isTecnicoRole(appId) && resource.data.tecnico == tecnicoAsociado(appId));
      allow create: if llevaFinanzas(appId) && descuentoValido();
      allow update: if llevaFinanzas(appId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aplicado', 'pagoId'])
          && (request.resource.data.aplicado is int || request.resource.data.aplicado is float)
          && request.resource.data.aplicado >= 0 && request.resource.data.aplicado <= resource.data.monto
          && resource.data.anulado == false
          && aplicaEnPago(appId, 'descuentosManuales'))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anulado', 'anuladoPor', 'anuladoEn'])
          && resource.data.aplicado == 0 && resource.data.anulado == false
          && request.resource.data.anulado == true
          && request.resource.data.anuladoPor == usuarioFinanzas(appId)
          && request.resource.data.anuladoEn is int));
      allow delete: if false;
    }

    // Cada orden incluida en un pago (el id es el de la orden): una orden no se paga dos veces porque este documento solo se puede crear si no
    // existe. Se crea junto con su pago, en el mismo lote; al anular el pago se borran y las órdenes vuelven a estar por pagar.
    match /artifacts/{appId}/public/data/ordenesPagadas/{docId} {
      allow read: if llevaFinanzas(appId);
      allow create: if llevaFinanzas(appId)
        && request.resource.data.keys().hasOnly(['pagoId', 'tecnico', 'concepto', 'monto', 'dia', 'codigo'])
        && request.resource.data.pagoId is string && request.resource.data.pagoId.size() > 0
        && existsAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/pagosTecnicos/$(request.resource.data.pagoId))
        && request.resource.data.concepto in ['INSTALACION', 'VISITA', 'AVERIA', 'MUDANZA_INTERNA', 'MUDANZA_EXTERNA', 'VALIDACION_NAP', 'TRABAJO_ADICIONAL', 'RECABLEADO', 'LOW_SIGNAL', 'CAMBIO_EQUIPO']
        && request.resource.data.tecnico is string && request.resource.data.tecnico.size() > 0
        && (request.resource.data.monto is int || request.resource.data.monto is float) && request.resource.data.monto >= 0
        && request.resource.data.dia is string && request.resource.data.dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 40;
      allow update: if false;
      // Solo se borra al anular el pago: el mismo lote deja anulado el pago de esa orden. Una orden de un pago vigente no se saca de ahí (se podría pagar dos veces).
      allow delete: if llevaFinanzas(appId)
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/pagosTecnicos/$(resource.data.pagoId)).data.get('anulado', false) == true;
    }

    match /artifacts/{appId}/public/data/counters/{counterId} {
      allow read: if isActiveUser(appId);
      // Solo numera quien crea/asigna órdenes (ADMIN/USUARIO). Solo los dos campos
      // esperados, "ultimo" numérico positivo, y nunca puede retroceder (evita que
      // un cliente con bug/malicioso rompa la secuencia).
      allow create: if (isAdminUser(appId) || isUsuarioRole(appId))
        && request.resource.data.keys().hasOnly(['ultimo', 'actualizadoEn'])
        && request.resource.data.ultimo is int && request.resource.data.ultimo > 0;
      allow update: if (isAdminUser(appId) || isUsuarioRole(appId))
        && request.resource.data.keys().hasOnly(['ultimo', 'actualizadoEn'])
        && request.resource.data.ultimo is int
        && request.resource.data.ultimo >= resource.data.ultimo;
    }

    // El pago que el cliente hace por el cobro de una orden: un documento por orden (id = id de la orden) con los datos clave de la orden copiados, para
    // que el Cierre del día no lo afecte. El TECNICO crea el de su propia orden, una sola vez (no se edita): o registra el pago (POR_CONCILIAR, y reserva su
    // referencia en el mismo lote) o dice que el cliente paga después (PENDIENTE_COBRO, con nota). ADMINISTRACION y ADMIN lo concilian, lo cobran, lo marcan
    // sin cobrar o lo corrigen, siempre dejando quién y cuándo en el historial. Nadie lo borra. La OFICINA y el técnico dueño lo leen; el resto no.
    // El cobro de cada orden al cliente, para ADMINISTRACION (y el ADMIN): un documento por orden (id = id de la orden) que quien finaliza la orden (ADMIN, USUARIO o quien cierra) emite PENDIENTE al
    // finalizarla (una instalación sin monto; lo escribe Administración al cargarlo). Administración lo sube al portal de la empresa y lo marca CARGADO (o lo devuelve a PENDIENTE); si la orden cambia
    // cuando ya estaba cargado, queda `montoCambio` hasta que Administración lo confirma. La oficina solo sigue a la orden (monto, anulado, montoCambio) y nunca cambia el estado. Nadie lo borra.
    // Lo leen la oficina, Administración y Finanzas.
    match /artifacts/{appId}/public/data/cobrosClientes/{ticketId} {
      function oficinaCierra(appId) {
        return canCerrar(appId) || isUsuarioRole(appId);
      }

      function cobroValido() {
        let c = request.resource.data;
        return c.keys().hasOnly(['ticketId', 'codigo', 'nombre', 'cedula', 'telefono', 'tecnico', 'tipoTrabajo', 'tipoVisita', 'falla', 'esInstalacion', 'monto', 'moneda', 'estado', 'montoCambio', 'anulado', 'creadoEn', 'creadoPor', 'cargadoPor', 'cargadoEn', 'actualizadoEn', 'historial'])
          && c.keys().hasAll(['ticketId', 'codigo', 'nombre', 'cedula', 'telefono', 'tecnico', 'tipoTrabajo', 'tipoVisita', 'falla', 'esInstalacion', 'monto', 'moneda', 'estado', 'montoCambio', 'anulado', 'creadoEn', 'creadoPor', 'cargadoPor', 'cargadoEn', 'actualizadoEn', 'historial'])
          && c.ticketId == ticketId
          && c.codigo is string && c.codigo.size() <= 40
          && c.nombre is string && c.nombre.size() <= 200
          && c.cedula is string && c.cedula.size() <= 40
          && c.telefono is string && c.telefono.size() <= 80
          && c.tecnico is string && c.tecnico.size() <= 100
          && c.tipoTrabajo is string && c.tipoTrabajo.size() <= 60
          && c.tipoVisita is string && c.tipoVisita.size() <= 60
          && c.falla is string && c.falla.size() <= 100
          && c.esInstalacion is bool
          && (c.monto == null || ((c.monto is int || c.monto is float) && c.monto > 0 && c.monto <= 999999999))
          && c.moneda in ['', 'BS', 'USD']
          && (c.monto == null) == (c.moneda == '')
          && c.estado in ['PENDIENTE', 'CARGADO']
          && (c.estado == 'PENDIENTE' || c.monto != null)
          && (c.montoCambio == null || (c.montoCambio is map && c.montoCambio.keys().hasOnly(['anterior', 'nuevo'])))
          && c.anulado is bool
          && c.creadoEn is int && c.actualizadoEn is int && c.cargadoEn is int
          && c.creadoPor is string && c.creadoPor.size() > 0 && c.creadoPor.size() <= 100
          && c.cargadoPor is string && c.cargadoPor.size() <= 100
          && c.historial is list && c.historial.size() >= 1 && c.historial.size() <= 200;
      }

      allow read: if llevaAdministracion(appId) || oficinaCierra(appId) || isFinanzasRole(appId);
      allow create: if oficinaCierra(appId)
        && cobroValido()
        && request.resource.data.estado == 'PENDIENTE'
        && request.resource.data.anulado == false
        && request.resource.data.montoCambio == null
        && request.resource.data.cargadoPor == '' && request.resource.data.cargadoEn == 0
        && (request.resource.data.monto != null || request.resource.data.esInstalacion)
        && request.resource.data.historial.size() == 1
        && request.resource.data.creadoPor == usuarioFinanzas(appId);
      allow update: if cobroValido()
        && request.resource.data.historial.size() > resource.data.historial.size()
        && request.resource.data.historial.hasAll(resource.data.historial)
        && request.resource.data.ticketId == resource.data.ticketId
        && (
          // Administración: carga, devuelve a pendiente o confirma un cambio de monto (quien carga queda en cargadoPor).
          (llevaAdministracion(appId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'monto', 'moneda', 'montoCambio', 'anulado', 'cargadoPor', 'cargadoEn', 'actualizadoEn', 'historial'])
            && (request.resource.data.cargadoPor == resource.data.cargadoPor || request.resource.data.cargadoPor == '' || request.resource.data.cargadoPor == usuarioFinanzas(appId)))
          // La oficina: el cobro sigue a la orden (se actualiza el monto, se retira o queda el aviso de cambio), sin cambiar su estado.
          || (oficinaCierra(appId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['monto', 'moneda', 'montoCambio', 'anulado', 'actualizadoEn', 'historial'])
            && request.resource.data.estado == resource.data.estado)
        );
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/pagosOrdenes/{ticketId} {
      function referenciaDePago(appId) {
        return /databases/$(database)/documents/artifacts/$(appId)/public/data/referenciasPago/$(request.resource.data.referenciaClave);
      }

      function pagoOrdenValido() {
        let p = request.resource.data;
        return p.keys().hasOnly(['ticketId', 'codigo', 'nombre', 'cedula', 'telefono', 'tecnico', 'tipoTrabajo', 'falla', 'tipoVisita', 'estado', 'cobro', 'pago', 'referenciaClave', 'nota', 'compartidoCon', 'monedaDistinta', 'diferencia', 'registradoPor', 'registradoEn', 'conciliadoPor', 'conciliadoEn', 'notaAdministracion', 'creadoEn', 'actualizadoEn', 'historial'])
          && p.keys().hasAll(['ticketId', 'codigo', 'nombre', 'cedula', 'telefono', 'tecnico', 'tipoTrabajo', 'falla', 'tipoVisita', 'estado', 'cobro', 'pago', 'referenciaClave', 'nota', 'compartidoCon', 'monedaDistinta', 'diferencia', 'registradoPor', 'registradoEn', 'conciliadoPor', 'conciliadoEn', 'notaAdministracion', 'creadoEn', 'actualizadoEn', 'historial'])
          && p.ticketId == ticketId
          && p.codigo is string && p.codigo.size() <= 40
          && p.nombre is string && p.nombre.size() <= 200
          && p.cedula is string && p.cedula.size() <= 40
          && p.telefono is string && p.telefono.size() <= 80
          && p.tecnico is string && p.tecnico.size() > 0 && p.tecnico.size() <= 100
          && p.tipoTrabajo is string && p.tipoTrabajo.size() <= 60
          && p.falla is string && p.falla.size() <= 100
          && p.tipoVisita is string && p.tipoVisita.size() <= 60
          && p.estado in ['PENDIENTE_COBRO', 'POR_CONCILIAR', 'CONCILIADO', 'SIN_COBRAR']
          && (p.cobro == null || (p.cobro is map && p.cobro.keys().hasOnly(['monto', 'moneda']) && p.cobro.monto is number && p.cobro.monto > 0 && p.cobro.moneda in ['BS', 'USD']))
          && (p.pago == null || (p.pago is map
            && p.pago.keys().hasOnly(['moneda', 'forma', 'monto', 'banco', 'titular', 'cuentaEmpresa', 'referencia', 'pagadoEn'])
            && p.pago.keys().hasAll(['moneda', 'forma', 'monto', 'banco', 'cuentaEmpresa', 'referencia', 'pagadoEn'])
            && p.pago.moneda in ['BS', 'USD']
            && p.pago.forma in ['Pago móvil', 'Transferencia', 'Efectivo', 'Zelle', 'Binance', 'Otro']
            && p.pago.monto is number && p.pago.monto > 0 && p.pago.monto <= 999999999
            && p.pago.banco is string && p.pago.banco.size() <= 40
            && (!('titular' in p.pago) || (p.pago.titular is string && p.pago.titular.size() <= 80))
            && p.pago.cuentaEmpresa is string && p.pago.cuentaEmpresa.size() <= 160
            && p.pago.referencia is string && p.pago.referencia.size() <= 40
            && p.pago.pagadoEn is int))
          && p.referenciaClave is string && p.referenciaClave.size() <= 200
          && (p.referenciaClave == '' || p.referenciaClave.matches('^[a-z0-9_]+$'))
          && p.nota is string && p.nota.size() <= 300
          && p.notaAdministracion is string && p.notaAdministracion.size() <= 300
          && (p.compartidoCon == null || (p.compartidoCon is map && p.compartidoCon.keys().hasOnly(['id', 'codigo'])
            && p.compartidoCon.id is string && p.compartidoCon.id.size() > 0 && p.compartidoCon.id.size() <= 200 && p.compartidoCon.codigo is string && p.compartidoCon.codigo.size() <= 40))
          && p.monedaDistinta is bool && p.diferencia is bool
          && p.registradoPor is string && p.registradoPor.size() <= 100
          && p.conciliadoPor is string && p.conciliadoPor.size() <= 100
          && p.registradoEn is int && p.conciliadoEn is int && p.creadoEn is int && p.actualizadoEn is int
          && p.historial is list && p.historial.size() >= 1 && p.historial.size() <= 100;
      }

      // El técnico solo crea el pago de su propia orden, ya pre-finalizada o finalizada, y a su nombre.
      function tecnicoCreaSuPago(appId) {
        let p = request.resource.data;
        let orden = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/tickets/$(ticketId)).data;
        return isTecnicoRole(appId)
          && p.tecnico == tecnicoAsociado(appId)
          && orden.tecnico == tecnicoAsociado(appId)
          && orden.estado in ['PRE-FINALIZADO', 'FINALIZADO']
          && p.registradoPor == usuarioFinanzas(appId)
          && p.conciliadoPor == '' && p.conciliadoEn == 0 && p.notaAdministracion == ''
          && p.historial.size() == 1
          && (
            (p.estado == 'POR_CONCILIAR' && p.pago != null && p.compartidoCon == null
              && (p.pago.referencia == '') == (p.referenciaClave == '')
              // La referencia se reserva en el mismo lote y nadie la tenía: no se puede repetir en otra orden.
              && (p.referenciaClave == '' || (!exists(referenciaDePago(appId)) && existsAfter(referenciaDePago(appId)) && getAfter(referenciaDePago(appId)).data.ticketId == ticketId)))
            || (p.estado == 'PENDIENTE_COBRO' && p.pago == null && p.referenciaClave == '' && p.nota.size() > 0)
          );
      }

      // FINANZAS ve el pago, completo y en cualquier estado, de una instalación y de un cambio de equipo (y de ningún otro tipo de orden). Va con igualdades para que sus consultas por tipo se puedan comprobar.
      allow read: if llevaAdministracion(appId) || isUsuarioRole(appId) || (isTecnicoRole(appId) && resource.data.tecnico == tecnicoAsociado(appId))
        || (isFinanzasRole(appId) && (resource.data.tipoTrabajo == 'INSTALACIÓN' || resource.data.tipoTrabajo == 'CAMBIO DE EQUIPO' || resource.data.tipoVisita == 'CAMBIO_EQUIPO'));
      allow create: if pagoOrdenValido() && tecnicoCreaSuPago(appId);
      allow update: if llevaAdministracion(appId)
        && pagoOrdenValido()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'pago', 'referenciaClave', 'monedaDistinta', 'diferencia', 'conciliadoPor', 'conciliadoEn', 'notaAdministracion', 'actualizadoEn', 'historial'])
        && request.resource.data.historial.size() > resource.data.historial.size()
        && request.resource.data.historial.hasAll(resource.data.historial)
        && (request.resource.data.conciliadoPor == resource.data.conciliadoPor || request.resource.data.conciliadoPor == usuarioFinanzas(appId));
      allow delete: if false;
    }

    // Las referencias de pago ya usadas (un documento por referencia, con la forma de pago, el banco y el número ya normalizados como id): así dos técnicos no pueden
    // registrar la misma ni a la vez. Se crea en el mismo lote que el pago y nadie la cambia. Solo ADMINISTRACION y ADMIN pueden repetir una referencia (con nota) y
    // liberarla al corregirla o marcar el pago sin cobrar. El técnico consulta una por una (para decir en qué orden está), nunca la lista.
    match /artifacts/{appId}/public/data/referenciasPago/{clave} {
      allow get: if isTecnicoRole(appId) || isUsuarioRole(appId) || llevaAdministracion(appId);
      allow list: if llevaAdministracion(appId);
      allow create: if (isTecnicoRole(appId) || llevaAdministracion(appId))
        && clave.matches('^[a-z0-9_]{1,200}$')
        && request.resource.data.keys().hasOnly(['ticketId', 'codigo', 'por', 'en'])
        && request.resource.data.ticketId is string && request.resource.data.ticketId.size() > 0 && request.resource.data.ticketId.size() <= 200
        && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 40
        && request.resource.data.por == usuarioFinanzas(appId)
        && request.resource.data.en is int
        && existsAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/pagosOrdenes/$(request.resource.data.ticketId))
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/pagosOrdenes/$(request.resource.data.ticketId)).data.referenciaClave == clave
        && (llevaAdministracion(appId) || getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/pagosOrdenes/$(request.resource.data.ticketId)).data.tecnico == tecnicoAsociado(appId));
      allow update: if false;
      allow delete: if llevaAdministracion(appId);
    }

    match /artifacts/{appId}/public/data/config/{docId} {
      allow read: if isActiveUser(appId);
      allow write: if isAdminUser(appId);
    }

    // El cierre manual deja en config/cierreAutomatico la fecha de hoy (cierreManualFecha) para que el cierre automático de ese día
    // no corra. Lo puede escribir quien cierra, pero solo ese campo y sin crear el documento; la configuración sigue siendo de ADMIN.
    match /artifacts/{appId}/public/data/config/cierreAutomatico {
      allow update: if canCerrar(appId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cierreManualFecha']);
    }

    // El orden semanal (campo "orden") solo lo arma ADMIN. Pero USUARIO
    // también crea instalaciones, así que necesita poder avanzar el puntero
    // ("turnoActualIndex") al asignar una — sin tocar la lista en sí.
    match /artifacts/{appId}/public/data/config/turnoInstalaciones {
      allow read: if isActiveUser(appId);
      allow write: if isAdminUser(appId)
        || (isUsuarioRole(appId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['turnoActualIndex']));
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function profilePath(appId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid);
    }

    function isActiveUser(appId) {
      return isSignedIn()
        && exists(profilePath(appId))
        && get(profilePath(appId)).data.disabled != true;
    }

    function isAdminUser(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'ADMIN';
    }

    function isUsuarioRole(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'USUARIO';
    }

    function isTecnicoRole(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'TECNICO';
    }

    // ALMACEN y PROMOTORA solo leen: ninguna regla de escritura los incluye.
    function isAlmacenRole(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'ALMACEN';
    }

    function isPromotoraRole(appId) {
      return isActiveUser(appId) && get(profilePath(appId)).data.role == 'PROMOTORA';
    }

    // Los nombres (normalizados) con que una PROMOTORA aparece en las plantillas; ve las instalaciones con alguno.
    function promotoraClaves(appId) {
      return get(profilePath(appId)).data.get('promotoraClaves', []);
    }

    // Un perfil PROMOTORA con "ve todas" (ventas) lee las instalaciones de todas las promotoras. Solo lo escribe el ADMIN.
    function promotoraVeTodas(appId) {
      return get(profilePath(appId)).data.get('verTodasInstalaciones', false) == true;
    }

    function tecnicoAsociado(appId) {
      return get(profilePath(appId)).data.tecnicoAsociado;
    }

    function canCerrar(appId) {
      return isAdminUser(appId) || (isActiveUser(appId) && get(profilePath(appId)).data.puedeCerrar == true);
    }

    match /artifacts/{appId}/public/data/users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdminUser(appId));
      allow list: if isAdminUser(appId);
      allow create, delete: if isAdminUser(appId);
      // Registro de token de push: cada usuario puede agregar el suyo a su
      // propio perfil (arrayUnion), sin tocar ningún otro campo.
      allow update: if isAdminUser(appId)
        || (
          isSignedIn() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens'])
        );
    }

    match /artifacts/{appId}/public/data/technicians/{docId} {
      // TECNICO solo puede ver su propio técnico vinculado (el cliente debe
      // hacer where('name','==', tecnicoAsociado); sin eso el list se rechaza).
      allow read: if isAdminUser(appId) || isUsuarioRole(appId) || isAlmacenRole(appId)
        || (isTecnicoRole(appId) && resource.data.name == tecnicoAsociado(appId));

      // Alta/baja/color son de ADMIN. El toggle de activo/inactivo (pantalla
      // principal) también lo puede usar USUARIO (operativo, no estructural) y
      // cada TECNICO sobre su propio técnico vinculado, nunca sobre otro.
      allow create, delete: if isAdminUser(appId);
      allow update: if isAdminUser(appId)
        || (
          (isUsuarioRole(appId) || (isTecnicoRole(appId) && resource.data.name == tecnicoAsociado(appId)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo', 'activoUpdatedBy', 'activoUpdatedByRole', 'activoUpdatedAt'])
        );
    }

    match /artifacts/{appId}/public/data/tickets/{docId} {
      // TECNICO solo ve/edita sus propios tickets (los que tienen su nombre en
      // "tecnico"); el cliente debe hacer el query con where('tecnico','==', ...)
      // igualado a este valor, si no el list completo es rechazado.
      // ALMACEN cuenta el material de todas las órdenes; PROMOTORA solo ve las instalaciones que vendió ella (su
      // promotoraClave está entre las suyas). El cliente debe consultar con where('tipoTrabajo','==','INSTALACIÓN') y
      // where('promotoraClave','==', una de sus claves), si no la lectura es rechazada.
      allow read: if isAdminUser(appId) || isUsuarioRole(appId) || isAlmacenRole(appId)
        || (isPromotoraRole(appId) && resource.data.tipoTrabajo == 'INSTALACIÓN' && (promotoraVeTodas(appId) || resource.data.get('promotoraClave', '') in promotoraClaves(appId)))
        // Ventas (el PROMOTOR con "ve todas") también sigue las averías de tipo LOS: solo esas, y solo ellas.
        || (isPromotoraRole(appId) && promotoraVeTodas(appId) && resource.data.tipoTrabajo == 'AVERÍA' && resource.data.get('falla', '') == 'LOS')
        || (isTecnicoRole(appId) && resource.data.tecnico == tecnicoAsociado(appId));

      // Crear órdenes es acción de ADMIN/USUARIO; TECNICO no tiene esa UI.
      allow create: if isAdminUser(appId) || isUsuarioRole(appId);

      // TECNICO: solo su propio ticket y solo los campos de su trabajo (los que
      // tiene habilitados en Pre-finalizar / Detalles). El estado solo puede pasar
      // de PENDIENTE a PRE-FINALIZADO: nunca FINALIZADO/CANCELADO/ELIMINADO, ni
      // reabrir una orden. El historial solo crece: no puede borrar entradas.
      allow update: if isAdminUser(appId) || isUsuarioRole(appId)
        || (
          isTecnicoRole(appId)
          && resource.data.tecnico == tecnicoAsociado(appId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'nap', 'napCoordenadas', 'potenciaDbm', 'potencia1490Dbm', 'observacion', 'observacionInterna', 'tipoVisita', 'metrosCable', 'conectorExterno', 'conectorInterno', 'conectoresUsados', 'serialEquipo', 'instalacion', 'enCamino', 'historialEdiciones'])
          // "En camino" / "En sitio": solo a su nombre (o null para cancelarlo), nunca en nombre de otro técnico.
          && (request.resource.data.get('enCamino', null) == null
               || request.resource.data.enCamino.tecnico == tecnicoAsociado(appId))
          && (
            request.resource.data.estado == resource.data.estado
            || (resource.data.estado == 'PENDIENTE' && request.resource.data.estado == 'PRE-FINALIZADO')
          )
          && request.resource.data.get('historialEdiciones', []).hasAll(resource.data.get('historialEdiciones', []))
        );

      // El flujo normal borra vía "estado: ELIMINADO" (update, papelera). El borrado
      // físico real solo lo usa el proceso de cierre (Reportes), reservado a canCerrar.
      allow delete: if canCerrar(appId);
    }

    match /artifacts/{appId}/public/data/reports/{docId} {
      // ALMACEN lee los reportes para sumar el material de las órdenes ya archivadas.
      allow read: if canCerrar(appId) || isAlmacenRole(appId);
      allow write: if canCerrar(appId);
    }

    // Resumen liviano de las instalaciones cerradas de los últimos días (lo escribe el cierre del día, manual o
    // automático): lo único que la PROMOTORA ve de una instalación después de que sale de la lista de órdenes.
    match /artifacts/{appId}/public/data/historialInstalaciones/{docId} {
      // PROMOTORA: solo las de su promotora (resumenInstalacion guarda su promotoraClave).
      allow read: if canCerrar(appId) || (isPromotoraRole(appId) && (promotoraVeTodas(appId) || resource.data.get('promotoraClave', '') in promotoraClaves(appId)));
      allow write: if canCerrar(appId);
    }

    match /artifacts/{appId}/public/data/counters/{counterId} {
      allow read: if isActiveUser(appId);
      // Solo numera quien crea/asigna órdenes (ADMIN/USUARIO). Solo los dos campos
      // esperados, "ultimo" numérico positivo, y nunca puede retroceder (evita que
      // un cliente con bug/malicioso rompa la secuencia).
      allow create: if (isAdminUser(appId) || isUsuarioRole(appId))
        && request.resource.data.keys().hasOnly(['ultimo', 'actualizadoEn'])
        && request.resource.data.ultimo is int && request.resource.data.ultimo > 0;
      allow update: if (isAdminUser(appId) || isUsuarioRole(appId))
        && request.resource.data.keys().hasOnly(['ultimo', 'actualizadoEn'])
        && request.resource.data.ultimo is int
        && request.resource.data.ultimo >= resource.data.ultimo;
    }

    match /artifacts/{appId}/public/data/config/{docId} {
      allow read: if isActiveUser(appId);
      allow write: if isAdminUser(appId);
    }

    // El orden semanal (campo "orden") solo lo arma ADMIN. Pero USUARIO
    // también crea instalaciones, así que necesita poder avanzar el puntero
    // ("turnoActualIndex") al asignar una — sin tocar la lista en sí.
    match /artifacts/{appId}/public/data/config/turnoInstalaciones {
      allow read: if isActiveUser(appId);
      allow write: if isAdminUser(appId)
        || (isUsuarioRole(appId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['turnoActualIndex']));
    }
  }
}
